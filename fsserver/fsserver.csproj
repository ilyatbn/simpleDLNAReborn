<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>NMaier.SimpleDlna.FileMediaServer</RootNamespace>
    <AssemblyName>SimpleDlna.FileMediaServer</AssemblyName>
    <AssemblyTitle>File Server class library</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.2" />
    <!-- Replaces the "taglib" 2.1 package, which was last published in 2012 and
         only ships a .NET 3.5 assembly. Same TagLib namespace and API. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\server\server.csproj" />
    <ProjectReference Include="..\thumbs\thumbs.csproj" />
    <ProjectReference Include="..\util\util.csproj" />
  </ItemGroup>

</Project>
