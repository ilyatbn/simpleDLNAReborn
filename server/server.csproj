<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>NMaier.SimpleDlna.Server</RootNamespace>
    <AssemblyName>SimpleDlna.Server</AssemblyName>
    <AssemblyTitle>Server class library</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\util\util.csproj" />
  </ItemGroup>

  <!-- Properties\Resources.resx pulls the DLNA description/SOAP templates and
       the web UI assets in as byte[] via ResXFileRef; they must not also be
       copied to the output directory. -->
  <ItemGroup>
    <None Remove="Resources\**" />
    <None Include="Resources\**" />
  </ItemGroup>

</Project>
