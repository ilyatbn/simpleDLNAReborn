<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NMaier.SimpleDlna</RootNamespace>
    <AssemblyName>sdlna</AssemblyName>
    <AssemblyTitle>sdlna - SimpleDLNA Server</AssemblyTitle>
    <Description>A simple, zero-config DLNA server from command line</Description>
    <ApplicationIcon>sdlna.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.0.8 is the modernised GetOptNet; the attribute API used by Options.cs
         is unchanged from the 1.2 build this project used to reference. -->
    <PackageReference Include="GetOptNet" Version="4.0.8" />
    <PackageReference Include="log4net" Version="3.3.2" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\fsserver\fsserver.csproj" />
    <ProjectReference Include="..\server\server.csproj" />
    <ProjectReference Include="..\util\util.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\**" />
    <None Include="Resources\**" />
  </ItemGroup>

</Project>
